# ── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/bata-csr
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bata-csr
MONGODB_URI=mongodb://localhost:27017/bata-csr

# ── Session (generate with: openssl rand -base64 32) ─────
SESSION_SECRET=change-me-to-a-long-random-string

# ── Cloudflare R2 (S3-compatible object storage) ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bata-csr

# ── EmailJS (https://dashboard.emailjs.com) ──────────────
# Create a template with variables: to_email, to_name, subject, message
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── Seed script (npm run seed) ───────────────────────────
DIRECTOR_NAME=Bata Director
DIRECTOR_EMAIL=director@bata.com
DIRECTOR_PASSWORD=Director@123
